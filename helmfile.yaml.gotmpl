# `helmfile template` renders without talking to a cluster, so .Capabilities.APIVersions
# is empty. chart-libs.gateway-routes keys off
# `.Capabilities.APIVersions.Has "gateway.networking.k8s.io/v1"`: without it every
# non-public route takes the Ingress branch, which deliberately `fail`s (ForwardAuth /
# Cerbos enforcement has no Ingress equivalent). The result was that a cluster-free
# `helmfile template` always errored on auditflow, so it was useless as a check and the
# error had to be explained away as "expected".
#
# Declaring the API version here makes template render the same HTTPRoute branch that
# `helmfile apply` picks after install-crds has run. This only affects the template code
# path — apply/sync still read real capabilities from the cluster, so a genuinely missing
# CRD still fails at apply time, which is where it should fail.
helmDefaults:
  templateArgs:
    - --api-versions=gateway.networking.k8s.io/v1

repositories:
  - name: labs64io
    url: https://labs64.github.io/labs64.io-helm-charts
  - name: traefik
    url: https://traefik.github.io/charts
  - name: metrics-server
    url: https://kubernetes-sigs.github.io/metrics-server/
  - name: bitnami
    url: https://charts.bitnami.com/bitnami
  - name: open-telemetry
    url: https://open-telemetry.github.io/opentelemetry-helm-charts
  # Loki, Tempo and Grafana charts live here now. The old grafana.github.io repo marks its
  # tempo and grafana charts deprecated (last release 2026-01-30) and its loki chart trails
  # the community one by years of Loki releases.
  - name: grafana-community
    url: https://grafana-community.github.io/helm-charts
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts
  # NOTE: external-secrets is intentionally absent. Its classic chart repo
  # (charts.external-secrets.io -> ghs.googlehosted.com) is unreachable from some
  # networks, and because `helm repo update` fails hard on any single unreachable repo it
  # took down the whole `just up`. The release below pulls the same chart from ghcr.io via
  # OCI instead, which needs no repo entry.

environments:
  # CI targets this same "local" profile (a self-hosted runner attached to its own
  # k3d cluster) — see labs64.io-tests' regression-suite workflow. A distinct
  # "staging"/"prod" environment is installed from labs64.io-devops (Terraform +
  # `just modules-install`, the umbrella chart), not Helmfile; add one here only once real per-app
  # values.<env>.yaml files exist for it.
  local:
    values:
      - overrides/global-values.yaml
      - overrides/helmfile/values.local.yaml

---
{{ $idp := .Values | get "identityProvider" "mock" }}
{{- /* Telemetry switch for the instrumented apps (label `observability: "true"` below).
       Off by default; the justfile passes `--state-values-set observability.enabled=true`
       whenever the OTel collector is running, on EVERY apply — so reinstalling an app can
       never silently drop its telemetry. */}}
{{ $observability := .Values | get "observability.enabled" false }}
{{ if not (has $idp (list "mock" "keycloak" "external")) }}
{{ fail (printf "identityProvider must be mock, keycloak or external (got %q)" $idp) }}
{{ end }}
releases:
  # === INFRASTRUCTURE ===
  - name: traefik
    namespace: tools
    chart: traefik/traefik
    version: 41.6.1
    values:
      - overrides/traefik/values.{{ .Environment.Name }}.yaml
    labels:
      layer: infra
    needs: []

  - name: external-secrets
    namespace: tools
    # Same chart as the classic repo, served over OCI from ghcr.io.
    # Latest release; both repos migrated to external-secrets.io/v1 only (chart-libs since 0.7.0,
    # overrides/eso to match). Must equal ESO_CHART_VERSION in labs64.io-devops (the AWS path);
    # `just check-pins` (labs64.io-workspace) fails if they differ.
    chart: oci://ghcr.io/external-secrets/charts/external-secrets
    version: 2.11.0
    set:
      - name: installCRDs
        value: true
    labels:
      layer: infra

  # Local RabbitMQ on the official image (overrides/rabbitmq/chart). The Bitnami chart is frozen at
  # 4.1.3 and its versioned images exist only in the unpatched `bitnamilegacy/*` namespace.
  # Upgrading an existing cluster: `helm uninstall rabbitmq -n tools` first (the StatefulSet
  # selector and volume claim differ), then `just up`; the new broker starts with a fresh volume.
  - name: rabbitmq
    namespace: tools
    chart: ./overrides/rabbitmq/chart
    values:
      - overrides/rabbitmq/values.secrets.{{ .Environment.Name }}.yaml
    labels:
      layer: infra

  - name: postgresql
    namespace: tools
    chart: bitnami/postgresql
    version: 18.12.4
    values:
      - overrides/postgresql/values.{{ .Environment.Name }}.yaml
    labels:
      layer: infra

  # bitnami/valkey, not bitnami/redis — AWS ElastiCache (labs64.io-devops) runs Valkey, and
  # keeping local dev on the same engine avoids drift from a different (if protocol-compatible)
  # project. Release name stays "redis" (overrides/redis/values.local.yaml pins
  # fullnameOverride: "redis" so the resulting Service name doesn't change).
  - name: redis
    namespace: tools
    chart: bitnami/valkey
    version: 6.3.4
    values:
      - overrides/redis/values.{{ .Environment.Name }}.yaml
    labels:
      layer: infra

  # === IDENTITY ===
  # overrides/helmfile/values.<env>.yaml `identityProvider` installs at most one provider and
  # (see labs64io-api-gateway below) points api-gateway at it. `external` installs neither.
  - name: mock-oidc
    installed: {{ eq $idp "mock" }}
    namespace: tools
    chart: ./charts/mock-oidc
    values:
      - ./charts/mock-oidc/values.yaml
      - ./overrides/mock-oidc/values.{{ .Environment.Name }}.yaml
    labels:
      layer: identity
      provider: mock
    needs:
      - tools/traefik

  - name: keycloak
    installed: {{ eq $idp "keycloak" }}
    namespace: tools
    chart: oci://ghcr.io/codecentric/helm-charts/keycloakx
    version: 7.3.2
    values:
      - ./overrides/keycloak/values.yaml
      - ./overrides/keycloak/values.{{ .Environment.Name }}.yaml
      {{- if isFile (printf "./overrides/keycloak/values.secrets.%s.yaml" .Environment.Name) }}
      - ./overrides/keycloak/values.secrets.{{ .Environment.Name }}.yaml
      {{- end }}
    # The realm contract (realm.base.json) is shared with AWS; the test-fixture clients are added
    # locally (values.local.yaml sets labs64io.testFixtures) and, on AWS, in dev only (devops).
    set:
      - name: realmConfig
        file: ./overrides/keycloak/realm.base.json
      - name: realmFixtures
        file: ./overrides/keycloak/realm.test-fixtures.json
    labels:
      layer: identity
      provider: keycloak
    needs:
      - tools/traefik

  # === MONITORING ===
  - name: metrics-server
    namespace: kube-system
    chart: metrics-server/metrics-server
    version: 3.14.0
    values:
      - overrides/metrics-server/values.{{ .Environment.Name }}.yaml
    labels:
      layer: monitoring

  - name: opentelemetry-operator
    namespace: monitoring
    chart: open-telemetry/opentelemetry-operator
    version: 0.124.1
    values:
      - overrides/opentelemetry/values-operator.{{ .Environment.Name }}.yaml
    labels:
      layer: monitoring

  - name: opentelemetry-collector
    namespace: monitoring
    chart: open-telemetry/opentelemetry-collector
    version: 0.175.0
    values:
      - overrides/opentelemetry/values-collector.{{ .Environment.Name }}.yaml
    labels:
      layer: monitoring

  - name: prometheus
    namespace: monitoring
    chart: prometheus-community/kube-prometheus-stack
    version: 91.9.0
    values:
      - overrides/prometheus/values.{{ .Environment.Name }}.yaml
    labels:
      layer: monitoring

  - name: loki
    namespace: monitoring
    chart: grafana-community/loki
    version: 18.13.8
    values:
      - overrides/loki/values.{{ .Environment.Name }}.yaml
    labels:
      layer: monitoring

  - name: tempo
    namespace: monitoring
    chart: grafana-community/tempo
    version: 3.1.0
    values:
      - overrides/tempo/values.{{ .Environment.Name }}.yaml
    labels:
      layer: monitoring

  - name: grafana
    namespace: monitoring
    chart: grafana-community/grafana
    version: 13.2.7
    values:
      - overrides/grafana/values.{{ .Environment.Name }}.yaml
    labels:
      layer: monitoring

  # === LABS64IO APPS ===
  - name: labs64io-authz-pdp
    namespace: labs64io
    chart: ./charts/authz-pdp
    values:
      - ./charts/authz-pdp/values.yaml
      - ./overrides/global-values.yaml
      - ./overrides/authz-pdp/values.{{ .Environment.Name }}.yaml
    labels:
      layer: apps
    needs:
      - tools/traefik

  - name: labs64io-api-gateway
    namespace: labs64io
    chart: ./charts/api-gateway
    values:
      - ./charts/api-gateway/values.yaml
      - ./overrides/global-values.yaml
      - ./overrides/api-gateway/values.{{ .Environment.Name }}.yaml
      # OIDC discovery/issuer/audience + egress for the selected identity provider.
      - ./overrides/api-gateway/oidc-{{ $idp }}.{{ .Environment.Name }}.yaml
    {{- if $observability }}
    set:
      - name: observability.enabled
        value: true
    {{- end }}
    labels:
      layer: apps
      observability: "true"
    needs:
      - tools/traefik

  - name: labs64io-api-docs
    namespace: labs64io
    chart: ./charts/api-docs
    values:
      - ./charts/api-docs/values.yaml
      - ./overrides/global-values.yaml
      - ./overrides/api-docs/values.{{ .Environment.Name }}.yaml
    labels:
      layer: apps
    needs:
      - tools/traefik

  - name: labs64io-auditflow
    namespace: labs64io
    chart: ./charts/auditflow
    values:
      - ./charts/auditflow/values.yaml
      - ./overrides/global-values.yaml
      - ./overrides/auditflow/values.{{ .Environment.Name }}.yaml
      # Static local secrets file (see `just generate-secrets`). Not SOPS-encrypted, so a
      # plain conditional value file rather than helmfile's `secrets:` (SOPS) mechanism.
      # Absent once externalSecrets.enabled replaces it for an environment.
      {{- if isFile (printf "./overrides/auditflow/values.secrets.%s.yaml" .Environment.Name) }}
      - ./overrides/auditflow/values.secrets.{{ .Environment.Name }}.yaml
      {{- end }}
    {{- if $observability }}
    set:
      - name: observability.enabled
        value: true
    {{- end }}
    labels:
      layer: apps
      observability: "true"
    needs:
      - tools/rabbitmq
      # Its HTTPRoute's ExtensionRef filters resolve gateway.sharedMiddlewares
      # (compress/buffering) by name against the Middleware CRDs api-gateway
      # creates; without this edge helmfile can schedule both releases
      # concurrently, and Traefik logs transient "middleware ... does not
      # exist" errors if the route is reconciled before the Middleware exists.
      - labs64io/labs64io-api-gateway

  - name: labs64io-checkout
    # Not GA: left out of the default set. `just install-app checkout` installs it on
    # explicit request (state value installCheckout). TODO: default to true when GA.
    installed: {{ .Values | get "installCheckout" false }}
    namespace: labs64io
    chart: ./charts/checkout
    values:
      - ./charts/checkout/values.yaml
      - ./overrides/global-values.yaml
      - ./overrides/checkout/values.{{ .Environment.Name }}.yaml
      {{- if isFile (printf "./overrides/checkout/values.secrets.%s.yaml" .Environment.Name) }}
      - ./overrides/checkout/values.secrets.{{ .Environment.Name }}.yaml
      {{- end }}
    labels:
      layer: apps
    needs:
      - tools/postgresql
      # See labs64io-auditflow above: its HTTPRoute also resolves shared
      # Middlewares by name against what api-gateway creates.
      - labs64io/labs64io-api-gateway

  - name: labs64io-payment-gateway
    namespace: labs64io
    chart: ./charts/payment-gateway
    values:
      - ./charts/payment-gateway/values.yaml
      - ./overrides/global-values.yaml
      - ./overrides/payment-gateway/values.{{ .Environment.Name }}.yaml
      {{- if isFile (printf "./overrides/payment-gateway/values.secrets.%s.yaml" .Environment.Name) }}
      - ./overrides/payment-gateway/values.secrets.{{ .Environment.Name }}.yaml
      {{- end }}
    {{- if $observability }}
    set:
      - name: observability.enabled
        value: true
    {{- end }}
    labels:
      layer: apps
      observability: "true"
    needs:
      - tools/postgresql
      - tools/redis
      - tools/traefik
      - labs64io/labs64io-api-gateway
      - labs64io/labs64io-auditflow

  - name: labs64io-customer-portal
    namespace: labs64io
    chart: ./charts/customer-portal
    values:
      - ./charts/customer-portal/values.yaml
      - ./overrides/global-values.yaml
      - ./overrides/customer-portal/values.{{ .Environment.Name }}.yaml
    labels:
      layer: apps
    needs:
      - tools/traefik
      # See labs64io-auditflow above: its HTTPRoute also resolves shared
      # Middlewares by name against what api-gateway creates.
      - labs64io/labs64io-api-gateway
