    "keycloak": {
      "additionalProperties": true,
      "description": "Optional in-cluster Keycloak. Leave disabled when using an externally\nmanaged OIDC issuer and configure api-gateway.oidc for that issuer instead.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "enabled",
          "type": "boolean"
        },
        "gateway": {
          "additionalProperties": false,
          "properties": {
            "parentRefs": {
              "items": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "default": "labs64io-gateway",
                        "title": "name",
                        "type": "string"
                      },
                      "namespace": {
                        "default": "tools",
                        "title": "namespace",
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "namespace"
                    ],
                    "type": "object"
                  }
                ],
                "required": []
              },
              "title": "parentRefs",
              "type": "array"
            }
          },
          "required": [
            "parentRefs"
          ],
          "title": "gateway",
          "type": "object"
        }
      },
      "required": [
        "enabled",
        "gateway"
      ],
      "title": "keycloak",
      "type": "object"
    },
    "mock-oidc": {
      "additionalProperties": false,
      "description": "Dev-only OIDC provider. Requires demoMode=true — the chart refuses to render\notherwise. Issues tokens to anyone who asks and authenticates nobody; never\nenable it outside a throwaway demo.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "enabled",
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "mock-oidc",
      "type": "object"
    },
    "networkPolicy": {
      "additionalProperties": false,
      "description": "NetworkPolicy for this chart's own workload (templates/rabbitmq.yaml — the only\nlong-running workload this chart declares itself; every module's own NetworkPolicy is\nconfigured under that module's own key, e.g. `auditflow.networkPolicy`).",
      "properties": {
        "enabled": {
          "default": false,
          "title": "enabled",
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
