    "postgresql": {
      "additionalProperties": true,
      "description": "Opt-In Infrastructure (Enabled by default for one-click dev deployments)",
      "properties": {
        "auth": {
          "additionalProperties": true,
          "properties": {
            "database": {
              "default": "labs64io",
              "title": "database",
              "type": "string"
            },
            "existingSecret": {
              "default": "labs64io-shared-secret",
              "title": "existingSecret",
              "type": "string"
            },
            "secretKeys": {
              "additionalProperties": true,
              "properties": {
                "adminPasswordKey": {
                  "default": "SPRING_DATASOURCE_PASSWORD",
                  "title": "adminPasswordKey",
                  "type": "string"
                },
                "userPasswordKey": {
                  "default": "SPRING_DATASOURCE_PASSWORD",
                  "title": "userPasswordKey",
                  "type": "string"
                }
              },
              "required": [
                "adminPasswordKey",
                "userPasswordKey"
              ],
              "title": "secretKeys",
              "type": "object"
            },
            "username": {
              "default": "labs64",
              "title": "username",
              "type": "string"
            }
          },
          "required": [
            "username",
            "database",
            "existingSecret"
          ],
          "title": "auth",
          "type": "object"
        },
        "enabled": {
          "default": true,
          "title": "enabled",
          "type": "boolean"
        },
        "fullnameOverride": {
          "default": "labs64io-postgresql",
          "description": "Pinned so `global.postgresql.host` above can be a plain string (standalone\narchitecture: no \"-primary\" suffix on the resulting service name)",
          "title": "fullnameOverride",
          "type": "string"
        },
        "primary": {
          "additionalProperties": true,
          "description": "TODO: pin this image. The subchart defaults to `latest`, which pulls today but is\nmutable: a re-pull can move the PostgreSQL MAJOR version under an existing PVC, and\nPostgreSQL refuses to start on a data directory written by a different major — a\nroutine pod restart that presents as data loss. There is currently no tag to pin to:\ndocker.io/bitnami/postgresql carries only `latest`, and bitnamilegacy/postgresql\nstops at 17.6.0 while this subchart (18.7.11) targets appVersion 18.4.0. Pin by\ndigest, or move to oci://registry-1.docker.io/bitnamicharts, once one is available.\nEach module owns its own database (db-per-service isolation — see the note on\nglobal.postgresql above). The Bitnami chart creates only `auth.database`, and the\nmodules' own pre-install migration Jobs cannot create the rest: they run before\nthis server exists. Creating them here, at first initdb, is the only point in the\nrelease where the ordering works. Runs once, on an empty data directory only —\nenabling a module later needs the database created by hand.",
          "properties": {
            "initdb": {
              "additionalProperties": true,
              "properties": {
                "scripts": {
                  "additionalProperties": true,
                  "properties": {
                    "00-labs64io-databases.sql": {
                      "default": "SELECT 'CREATE DATABASE payment_gateway'\n  WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'payment_gateway')\\gexec\nSELECT 'CREATE DATABASE checkout'\n  WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'checkout')\\gexec\n",
                      "title": "00-labs64io-databases.sql",
                      "type": "string"
                    }
                  },
                  "required": [
                    "00-labs64io-databases.sql"
                  ],
                  "title": "scripts",
                  "type": "object"
                }
              },
              "required": [],
              "title": "initdb",
              "type": "object"
            },
            "networkPolicy": {
              "additionalProperties": true,
              "properties": {
                "allowExternalEgress": {
                  "default": false,
                  "description": "The chart default (true) allows all-ports/all-destinations egress from the primary\npod — Postgres never initiates outbound connections, so it needs none.",
                  "title": "allowExternalEgress",
                  "type": "boolean"
                }
              },
              "required": [
                "allowExternalEgress"
              ],
              "title": "networkPolicy",
              "type": "object"
            }
          },
          "required": [],
          "title": "primary",
          "type": "object"
        }
      },
      "required": [
        "enabled",
        "fullnameOverride"
      ],
      "title": "postgresql",
      "type": "object"
    },
    "rabbitmq": {
      "additionalProperties": true,
      "properties": {
        "auth": {
          "additionalProperties": true,
          "properties": {
            "existingPasswordSecret": {
              "default": "labs64io-shared-secret",
              "title": "existingPasswordSecret",
              "type": "string"
            },
            "existingSecretPasswordKey": {
              "default": "SPRING_RABBITMQ_PASSWORD",
              "title": "existingSecretPasswordKey",
              "type": "string"
            },
            "username": {
              "default": "labs64",
              "title": "username",
              "type": "string"
            }
          },
          "required": [
            "username",
            "existingPasswordSecret",
            "existingSecretPasswordKey"
          ],
          "title": "auth",
          "type": "object"
        },
        "enabled": {
          "default": true,
          "title": "enabled",
          "type": "boolean"
        },
        "fullnameOverride": {
          "default": "labs64io-rabbitmq",
          "description": "Pinned so `global.rabbitmq.host` above can be a plain string. Also used directly by\ntemplates/rabbitmq.yaml (this is not a chart dependency — see the Chart.yaml comment).",
          "title": "fullnameOverride",
          "type": "string"
        },
        "image": {
          "additionalProperties": true,
          "description": "The official image, not Bitnami: pinned to the 4.3.x track (matches Amazon MQ) rather than\nthe floating `4-management` tag, which would silently jump to RabbitMQ 5.x on the next pull.",
          "properties": {
            "registry": {
              "default": "docker.io",
              "title": "registry",
              "type": "string"
            },
            "repository": {
              "default": "library/rabbitmq",
              "title": "repository",
              "type": "string"
            },
            "tag": {
              "default": "4.3-management",
              "title": "tag",
              "type": "string"
            }
          },
          "required": [
            "registry",
            "repository",
            "tag"
          ],
          "title": "image",
          "type": "object"
        },
        "persistence": {
          "additionalProperties": false,
          "description": "Size of the RabbitMQ data volume (StatefulSet volumeClaimTemplate).",
          "properties": {
            "size": {
              "default": "1Gi",
              "title": "size",
              "type": "string"
            }
          },
          "required": [
            "size"
          ],
          "title": "persistence",
          "type": "object"
        }
      },
      "required": [
        "enabled",
        "fullnameOverride",
        "persistence"
      ],
      "title": "rabbitmq",
      "type": "object"
    },
    "redis": {
      "additionalProperties": true,
      "properties": {
        "architecture": {
          "default": "standalone",
          "description": "This is bitnami/valkey (Chart.yaml aliases it \"redis\" — see the dependency comment\nthere), matching the engine AWS ElastiCache runs (labs64.io-devops pins Valkey 9.1).\nTODO: pin this image — see the note under `postgresql` above. Same situation:\ndocker.io/bitnami/valkey carries only `latest` (currently Valkey 9.1.x). Lower\nstakes than PostgreSQL (no on-disk major-version barrier), but still mutable.",
          "title": "architecture",
          "type": "string"
        },
        "auth": {
          "additionalProperties": true,
          "properties": {
            "existingSecret": {
              "default": "labs64io-shared-secret",
              "title": "existingSecret",
              "type": "string"
            },
            "existingSecretPasswordKey": {
              "default": "SPRING_DATA_REDIS_PASSWORD",
              "title": "existingSecretPasswordKey",
              "type": "string"
            }
          },
          "required": [
            "existingSecret",
            "existingSecretPasswordKey"
          ],
          "title": "auth",
          "type": "object"
        },
        "enabled": {
          "default": true,
          "title": "enabled",
          "type": "boolean"
        },
        "fullnameOverride": {
          "default": "labs64io-redis",
          "description": "Pinned so `global.redis.host` above can be a plain string (standalone architecture:\nthe primary service is named \"\u003cfullnameOverride\u003e-primary\")",
          "title": "fullnameOverride",
          "type": "string"
        },
        "networkPolicy": {
          "additionalProperties": true,
          "properties": {
            "allowExternalEgress": {
              "default": false,
              "description": "The chart default (true) allows all-ports/all-destinations egress from the primary\npod — Valkey never initiates outbound connections, so it needs none.",
              "title": "allowExternalEgress",
              "type": "boolean"
            }
          },
          "required": [
            "allowExternalEgress"
          ],
          "title": "networkPolicy",
          "type": "object"
        }
      },
      "required": [
        "enabled",
        "architecture",
        "fullnameOverride"
      ],
      "title": "redis",
      "type": "object"
    },
    "secrets": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "additionalProperties": true,
          "description": "Additional key/value pairs merged into the shared Secret verbatim. Same shape\nas every module chart's `secrets.data`, so one caller code path covers both.\nKeys here win over the aliases above on collision.",
          "required": [],
          "title": "data",
          "type": "object"
        },
        "postgresqlPassword": {
          "default": "labs64_dev_password",
          "description": "Convenience aliases for the three bundled-infra passwords, injected into\nlabs64io-shared-secret. The shipped values are dev defaults — with\n`demoMode: false` (the default) the chart fails to render until they change.",
          "title": "postgresqlPassword",
          "type": "string"
        },
        "rabbitmqPassword": {
          "default": "labs64_dev_password",
          "description": "See `secrets.postgresqlPassword`.",
          "title": "rabbitmqPassword",
          "type": "string"
        },
        "redisPassword": {
          "default": "labs64_dev_password",
          "description": "See `secrets.postgresqlPassword`.",
          "title": "redisPassword",
          "type": "string"
        }
      },
      "required": [
        "postgresqlPassword",
        "rabbitmqPassword",
        "redisPassword"
      ],
      "title": "secrets",
      "type": "object"
