              "additionalProperties": true,
              "properties": {
                "enabled": {
                  "default": true,
                  "title": "enabled",
                  "type": "boolean"
                }
              },
              "required": [
                "enabled"
              ],
              "title": "kubernetesGateway",
              "type": "object"
            }
          },
          "required": [],
          "title": "providers",
          "type": "object"
        }
      },
      "required": [
        "enabled"
