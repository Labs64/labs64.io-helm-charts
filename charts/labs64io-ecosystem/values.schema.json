{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "api-docs": {
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "default": true,
          "title": "enabled",
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "api-docs",
      "type": "object"
    },
    "api-gateway": {
      "additionalProperties": true,
      "description": "Sub-charts Toggles",
      "properties": {
        "enabled": {
          "default": true,
          "title": "enabled",
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "api-gateway",
      "type": "object"
    },
    "auditflow": {
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "default": true,
          "title": "enabled",
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "auditflow",
      "type": "object"
    },
    "authz-pdp": {
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "default": true,
          "title": "enabled",
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "authz-pdp",
      "type": "object"
    },
    "checkout": {
      "additionalProperties": true,
      "description": "Not GA. The labs64/checkout and labs64/checkout-ui images have never been\npublished (both repositories 404 on Docker Hub), so enabling this yields\nImagePullBackOff. Toggle retained for when they are.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "enabled",
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "checkout",
      "type": "object"
    },
    "customer-portal": {
      "additionalProperties": true,
      "description": "Not GA. labs64/customer-portal-ui publishes no tags. Enable only once you have\na published customer-portal-ui image.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "enabled",
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "customer-portal",
      "type": "object"
    },
    "demoMode": {
      "default": false,
      "description": "Demo mode. Permits the dev-grade default passwords below and unlocks the\ndev-only mock-oidc subchart. MUST be false for any real deployment: with it\nfalse, the chart refuses to render while any password is still at its default.",
      "title": "demoMode",
      "type": "boolean"
    },
    "global": {
      "additionalProperties": true,
      "description": "Global Configuration Shared Across Ecosystem",
      "properties": {
        "postgresql": {
          "additionalProperties": false,
          "description": "External dependencies. Plain, fixed hostnames — the bundled Bitnami subcharts below are\npinned to matching `fullnameOverride`s, so these never need release-name templating (a\n`{{ .Release.Name }}-postgresql`-style string here would need a second `tpl` pass wherever\nit's consumed, which is exactly the class of bug this fixed-naming setup avoids).",
          "properties": {
            "database": {
              "default": "labs64io",
              "title": "database",
              "type": "string"
            },
            "host": {
              "default": "labs64io-postgresql",
              "title": "host",
              "type": "string"
            },
            "port": {
              "default": 5432,
              "title": "port",
              "type": "integer"
            },
            "username": {
              "default": "labs64",
              "title": "username",
              "type": "string"
            }
          },
          "required": [
            "host",
            "port",
            "username",
            "database"
          ],
          "title": "postgresql",
          "type": "object"
        },
        "rabbitmq": {
          "additionalProperties": false,
          "properties": {
            "host": {
              "default": "labs64io-rabbitmq",
              "title": "host",
              "type": "string"
            },
            "port": {
              "default": 5672,
              "title": "port",
              "type": "integer"
            },
            "username": {
              "default": "labs64",
              "title": "username",
              "type": "string"
            }
          },
          "required": [
            "host",
            "port",
            "username"
          ],
          "title": "rabbitmq",
          "type": "object"
        },
        "redis": {
          "additionalProperties": false,
          "properties": {
            "host": {
              "default": "labs64io-redis-master",
              "title": "host",
              "type": "string"
            },
            "port": {
              "default": 6379,
              "title": "port",
              "type": "integer"
            }
          },
          "required": [
            "host",
            "port"
          ],
          "title": "redis",
          "type": "object"
        },
        "security": {
          "additionalProperties": false,
          "description": "Required by the bitnamilegacy image override under `rabbitmq` below: the\nBitnami charts refuse a repository they do not recognise as official unless\nthis is set.",
          "properties": {
            "allowInsecureImages": {
              "default": true,
              "title": "allowInsecureImages",
              "type": "boolean"
            }
          },
          "required": [
            "allowInsecureImages"
          ],
          "title": "security",
          "type": "object"
        },
        "sharedConfig": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "default": true,
              "title": "enabled",
              "type": "boolean"
            },
            "name": {
              "default": "labs64io-shared-config",
              "title": "name",
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "name"
          ],
          "title": "sharedConfig",
          "type": "object"
        },
        "sharedSecret": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "default": true,
              "title": "enabled",
              "type": "boolean"
            },
            "name": {
              "default": "labs64io-shared-secret",
              "title": "name",
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "name"
          ],
          "title": "sharedSecret",
          "type": "object"
        }
      },
      "required": [
        "security",
        "sharedConfig",
        "sharedSecret",
        "postgresql",
        "rabbitmq",
        "redis"
      ],
      "title": "global",
      "type": "object"
    },
    "payment-gateway": {
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "default": true,
          "title": "enabled",
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "payment-gateway",
      "type": "object"
    },
    "postgresql": {
      "additionalProperties": true,
      "description": "Opt-In Infrastructure (Enabled by default for one-click dev deployments)",
      "properties": {
        "auth": {
          "additionalProperties": true,
          "description": "TODO: pin this image. The subchart defaults to `latest`, which pulls today but is\nmutable: a re-pull can move the PostgreSQL MAJOR version under an existing PVC, and\nPostgreSQL refuses to start on a data directory written by a different major — a\nroutine pod restart that presents as data loss. There is currently no tag to pin to:\ndocker.io/bitnami/postgresql carries only `latest`, and bitnamilegacy/postgresql\nstops at 17.6.0 while this subchart (18.7.11) targets appVersion 18.4.0. Pin by\ndigest, or move to oci://registry-1.docker.io/bitnamicharts, once one is available.",
          "properties": {
            "database": {
              "default": "labs64io",
              "title": "database",
              "type": "string"
            },
            "existingSecret": {
              "default": "labs64io-shared-secret",
              "title": "existingSecret",
              "type": "string"
            },
            "secretKeys": {
              "additionalProperties": true,
              "properties": {
                "adminPasswordKey": {
                  "default": "SPRING_DATASOURCE_PASSWORD",
                  "title": "adminPasswordKey",
                  "type": "string"
                },
                "userPasswordKey": {
                  "default": "SPRING_DATASOURCE_PASSWORD",
                  "title": "userPasswordKey",
                  "type": "string"
                }
              },
              "required": [
                "adminPasswordKey",
                "userPasswordKey"
              ],
              "title": "secretKeys",
              "type": "object"
            },
            "username": {
              "default": "labs64",
              "title": "username",
              "type": "string"
            }
          },
          "required": [
            "username",
            "database",
            "existingSecret"
          ],
          "title": "auth",
          "type": "object"
        },
        "enabled": {
          "default": true,
          "title": "enabled",
          "type": "boolean"
        },
        "fullnameOverride": {
          "default": "labs64io-postgresql",
          "description": "Pinned so `global.postgresql.host` above can be a plain string (standalone\narchitecture: no \"-primary\" suffix on the resulting service name)",
          "title": "fullnameOverride",
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "fullnameOverride"
      ],
      "title": "postgresql",
      "type": "object"
    },
    "rabbitmq": {
      "additionalProperties": true,
      "properties": {
        "auth": {
          "additionalProperties": true,
          "properties": {
            "existingPasswordSecret": {
              "default": "labs64io-shared-secret",
              "title": "existingPasswordSecret",
              "type": "string"
            },
            "existingSecretPasswordKey": {
              "default": "SPRING_RABBITMQ_PASSWORD",
              "title": "existingSecretPasswordKey",
              "type": "string"
            },
            "username": {
              "default": "labs64",
              "title": "username",
              "type": "string"
            }
          },
          "required": [
            "username",
            "existingPasswordSecret",
            "existingSecretPasswordKey"
          ],
          "title": "auth",
          "type": "object"
        },
        "enabled": {
          "default": true,
          "title": "enabled",
          "type": "boolean"
        },
        "fullnameOverride": {
          "default": "labs64io-rabbitmq",
          "description": "Pinned so `global.rabbitmq.host` above can be a plain string",
          "title": "fullnameOverride",
          "type": "string"
        },
        "image": {
          "additionalProperties": true,
          "description": "docker.io/bitnami/rabbitmq:4.1.3-debian-12-r1 (the subchart default) returns\n404: since 2025-08-28 the Bitnami free tier carries only rolling tags, and this\nis the one bundled subchart that pins a versioned one. The versioned image lives\nin bitnamilegacy/*, which needs global.security.allowInsecureImages above. Same\nfix as overrides/rabbitmq/values.local.yaml and charts/preflight.",
          "properties": {
            "registry": {
              "default": "docker.io",
              "title": "registry",
              "type": "string"
            },
            "repository": {
              "default": "bitnamilegacy/rabbitmq",
              "title": "repository",
              "type": "string"
            },
            "tag": {
              "default": "4.1.3-debian-12-r1",
              "title": "tag",
              "type": "string"
            }
          },
          "required": [
            "registry",
            "repository",
            "tag"
          ],
          "title": "image",
          "type": "object"
        }
      },
      "required": [
        "enabled",
        "fullnameOverride"
      ],
      "title": "rabbitmq",
      "type": "object"
    },
    "redis": {
      "additionalProperties": true,
      "properties": {
        "architecture": {
          "default": "standalone",
          "description": "TODO: pin this image — see the note under `postgresql` above. Same situation:\ndocker.io/bitnami/redis carries only `latest` and bitnamilegacy/redis stops at\n8.2.1 while this subchart (27.0.13) targets appVersion 8.8.0. Lower stakes than\nPostgreSQL (no on-disk major-version barrier), but still mutable.",
          "title": "architecture",
          "type": "string"
        },
        "auth": {
          "additionalProperties": true,
          "properties": {
            "existingSecret": {
              "default": "labs64io-shared-secret",
              "title": "existingSecret",
              "type": "string"
            },
            "existingSecretPasswordKey": {
              "default": "SPRING_DATA_REDIS_PASSWORD",
              "title": "existingSecretPasswordKey",
              "type": "string"
            }
          },
          "required": [
            "existingSecret",
            "existingSecretPasswordKey"
          ],
          "title": "auth",
          "type": "object"
        },
        "enabled": {
          "default": true,
          "title": "enabled",
          "type": "boolean"
        },
        "fullnameOverride": {
          "default": "labs64io-redis",
          "description": "Pinned so `global.redis.host` above can be a plain string (standalone architecture:\nthe primary/master service is named \"\u003cfullnameOverride\u003e-master\")",
          "title": "fullnameOverride",
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "architecture",
        "fullnameOverride"
      ],
      "title": "redis",
      "type": "object"
    },
    "secrets": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "additionalProperties": true,
          "description": "Additional key/value pairs merged into the shared Secret verbatim. Same shape\nas every module chart's `secrets.data`, so one caller code path covers both.\nKeys here win over the aliases above on collision.",
          "required": [],
          "title": "data",
          "type": "object"
        },
        "postgresqlPassword": {
          "default": "labs64_dev_password",
          "description": "Convenience aliases for the three bundled-infra passwords, injected into\nlabs64io-shared-secret. The shipped values are dev defaults — with\n`demoMode: false` (the default) the chart fails to render until they change.",
          "title": "postgresqlPassword",
          "type": "string"
        },
        "rabbitmqPassword": {
          "default": "labs64_dev_password",
          "description": "See `secrets.postgresqlPassword`.",
          "title": "rabbitmqPassword",
          "type": "string"
        },
        "redisPassword": {
          "default": "labs64_dev_password",
          "description": "See `secrets.postgresqlPassword`.",
          "title": "redisPassword",
          "type": "string"
        }
      },
      "required": [
        "postgresqlPassword",
        "rabbitmqPassword",
        "redisPassword"
      ],
      "title": "secrets",
      "type": "object"
    }
  },
  "required": [
    "demoMode",
    "secrets"
  ],
  "type": "object"
}
