      "description": "Opt-in Gateway. Without a GatewayClass and a Gateway named labs64io-gateway,\nevery module's HTTPRoute renders but sits Accepted:False and receives no traffic\n— pods running, nothing to curl. Enable this, or provision an equivalent Gateway\nyourself (see \"Gateway API setup\" in the chart repo's README).\n\nThe Gateway API CRDs are deliberately NOT bundled: Helm never upgrades CRDs from a\nchart's crds/ after first install. Apply them separately (`just install-crds`, or\ninstall.sh, which does it with `kubectl apply --server-side`).",
      "properties": {
        "enabled": {
          "default": false,
          "title": "enabled",
          "type": "boolean"
        },
        "gateway": {
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "default": true,
              "title": "enabled",
              "type": "boolean"
            },
            "listeners": {
              "additionalProperties": true,
              "properties": {
                "web": {
                  "additionalProperties": true,
                  "properties": {
                    "namespacePolicy": {
                      "additionalProperties": true,
                      "properties": {
                        "from": {
                          "default": "All",
                          "description": "Modules install into their own namespace; the listener must accept\nroutes from it.",
                          "title": "from",
                          "type": "string"
                        }
                      },
                      "required": [
                        "from"
                      ],
                      "title": "namespacePolicy",
                      "type": "object"
                    },
                    "port": {
                      "default": 8000,
                      "title": "port",
                      "type": "integer"
                    },
                    "protocol": {
                      "default": "HTTP",
                      "title": "protocol",
                      "type": "string"
                    }
                  },
                  "required": [
                    "port",
                    "protocol"
                  ],
                  "title": "web",
                  "type": "object"
                }
              },
              "required": [],
              "title": "listeners",
              "type": "object"
            },
            "name": {
              "default": "labs64io-gateway",
              "title": "name",
              "type": "string"
            },
            "namespace": {
              "default": "tools",
              "title": "namespace",
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "name",
            "namespace"
          ],
          "title": "gateway",
          "type": "object"
        },
        "gatewayClass": {
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "default": true,
              "title": "enabled",
              "type": "boolean"
            }
