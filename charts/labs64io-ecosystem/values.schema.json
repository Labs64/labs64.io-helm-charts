          "properties": {
            "database": {
              "default": "labs64io",
              "title": "database",
              "type": "string"
            },
            "host": {
              "default": "labs64io-postgresql",
              "title": "host",
              "type": "string"
            },
            "port": {
              "default": 5432,
              "title": "port",
              "type": "integer"
            },
            "username": {
              "default": "labs64",
              "title": "username",
              "type": "string"
            }
          },
          "required": [
            "host",
            "port",
            "username",
            "database"
          ],
          "title": "postgresql",
          "type": "object"
        },
        "rabbitmq": {
          "additionalProperties": false,
          "properties": {
            "host": {
              "default": "labs64io-rabbitmq",
              "title": "host",
              "type": "string"
            },
            "port": {
              "default": 5672,
              "title": "port",
              "type": "integer"
            },
            "username": {
              "default": "labs64",
              "title": "username",
              "type": "string"
            }
          },
          "required": [
            "host",
            "port",
            "username"
          ],
          "title": "rabbitmq",
          "type": "object"
        },
        "redis": {
          "additionalProperties": false,
          "properties": {
            "host": {
              "default": "labs64io-redis-primary",
              "description": "Bitnami's Valkey chart names its standalone service \"\u003cfullname\u003e-primary\" (the\nolder Redis chart used \"-master\" — verified against the packaged chart's own\ntemplates/primary/service.yaml before switching; changing this string without\nre-checking that would silently break every module's cache connection).",
              "title": "host",
              "type": "string"
            },
            "port": {
              "default": 6379,
              "title": "port",
              "type": "integer"
