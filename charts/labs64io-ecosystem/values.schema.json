          "properties": {
            "allowInsecureImages": {
              "default": true,
              "title": "allowInsecureImages",
              "type": "boolean"
            }
          },
          "required": [
            "allowInsecureImages"
          ],
          "title": "security",
          "type": "object"
        },
        "sharedConfig": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "default": true,
              "title": "enabled",
              "type": "boolean"
            },
            "name": {
              "default": "labs64io-shared-config",
              "title": "name",
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "name"
          ],
          "title": "sharedConfig",
          "type": "object"
        },
        "sharedSecret": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "default": true,
              "title": "enabled",
              "type": "boolean"
            },
            "name": {
              "default": "labs64io-shared-secret",
              "title": "name",
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "name"
          ],
          "title": "sharedSecret",
          "type": "object"
        }
