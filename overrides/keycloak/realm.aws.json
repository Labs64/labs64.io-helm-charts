{
  "clients": [
    {
      "clientId": "netlicensing",
      "description": "NetLicensing publishing audit events to AuditFlow (tenant netlicensing). client_credentials only.",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:NETLICENSING_CLIENT_SECRET)",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "canary",
      "description": "Synthetic check of the public edge (labs64.io-devops): token + publish to the _platform tenant every 5 minutes.",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:CANARY_CLIENT_SECRET)",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "service-account-netlicensing",
      "enabled": true,
      "serviceAccountClientId": "netlicensing",
      "attributes": {
        "tenant": ["netlicensing"]
      },
      "realmRoles": ["audit-event:write"]
    },
    {
      "username": "service-account-canary",
      "enabled": true,
      "serviceAccountClientId": "canary",
      "attributes": {
        "tenant": ["_platform"]
      },
      "realmRoles": ["audit-event:write"]
    }
  ]
}
